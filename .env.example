# Copy these into GitHub Secrets (repo Settings → Secrets → Actions)
# or Vercel Dashboard → Project → Settings → Environment Variables
# (Vercel: use "Import .env" with your filled local .env file).
# NEVER commit real values to git (.env is gitignored).

# Facebook Page (Ethan Cole — ID already filled)
FB_PAGE_ID=1264009986803820
# Long-lived Page token (~60 days). Mint via Graph Explorer, see README.
FB_PAGE_ACCESS_TOKEN=

# Google AI Studio key POOL (comma-separated, no spaces). The bot rotates
# the starting key every 20-min run and fails over to the next key on any
# 429/quota error, so all keys share the load evenly across the day.
GEMINI_API_KEYS=key1,key2,key3,key4,key5
# Backwards-compat single key (used only if GEMINI_API_KEYS is empty).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Backup writer (used only if all Gemini keys fail).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# Daily video rule: normal bar 4, after 20:00 UTC the bar drops to 1 so the
# day still gets its reel/video. Tune without touching code.
MIN_VIDEO_SCORE=4
VIDEO_DEADLINE_HOUR=20
VIDEO_DEADLINE_SCORE=1

# Rage mix: 3 viral posts out of every 5 (60%), boost +3 when starved.
RAGE_TARGET=3
RAGE_BOOST=3

# Daily floor: at least 4 posts/day always. Behind pace the bar drops
# toward FLOOR_MIN_SCORE; after 21:00 UTC unmet = catchup burst mode.
MIN_POSTS_PER_DAY=10
FLOOR_MIN_SCORE=2
FLOOR_DEADLINE_HOUR=21

# Anti-spam guards (live wire: ~30-min gaps, up to 15/day).
MIN_POST_GAP_MINUTES=30
MAX_POSTS_PER_DAY=15
MIN_PUBLISH_SCORE=6
MAX_AGE_MINUTES=1440

# Stories toggle: every post is also published as a 24h Page Story
# (photo + full caption as a vertical card, or text-only card).
# Video stories need FB's 3-phase upload flow (not yet implemented).
POST_STORIES=1

# Live web scenes in splits. OFF by default: unvetted web images
# produced meme garbage. Curated pile only unless explicitly enabled.
LIVE_SCENES=0

# Photo selectivity: photo only when genuinely good (story's own image,
# face, logo, or split starring one). Generic scenes go text-only.
# PHOTO_SELECTIVE=0 restores photo-on-every-post.
PHOTO_SELECTIVE=1

# Google image source (real editorial photos). Setup (~5 min, free):
# 1. console.cloud.google.com → new project → enable Custom Search API →
#    Credentials → API key (= GOOGLE_CSE_KEY, 100 free searches/day).
# 2. programmablesearchengine.google.com → Add → search the entire web,
#    Image search ON → copy Search engine ID (= GOOGLE_CSE_CX).
# 3. Paste both here / in secrets. scripts/fetch_google.py refreshes the
#    bundled pile through it.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Vercel Cron protection (optional). If set, /api/cron requires
# Authorization: Bearer <secret> or ?key=<secret>.
CRON_SECRET=

# Leadership verification freshness (days). Inferred faces (Fed chair,
# Apple CEO, country leaders in titled headlines) require a fresh
# Wikipedia infobox check; older cache triggers re-verification.
LEADERSHIP_MAX_AGE_DAYS=7

# Telegram alerts (bot failures + new-post share ping + weekly checks).
# 1. Message your bot once (e.g. @DealsKhaledBOT) so it can reach you.
# 2. Get your numeric chat id (e.g. via @userinfobot) and set both as
#    GitHub Secrets (repo Settings → Secrets → Actions).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Manual group shares (Groups API is deprecated — auto-posting is impossible).
# Comma-separated group names, shown in the "post live" Telegram ping as a
# one-tap reminder. Set as GitHub Secret GROUP_SHARE_TARGETS + local .env.
GROUP_SHARE_TARGETS=
# Follower goal tracked in the daily digest (pace vs required +/day).
GOAL_FOLLOWERS=10000
GOAL_DEADLINE=2027-09-29

# Undying-token chain (monthly self-heal workflow). One-time manual
# bootstrap, then the workflow sustains itself. See README section 6.
FB_APP_ID=
FB_APP_SECRET=
FB_USER_TOKEN=
# GH_PAT: classic GitHub PAT with `repo` scope (repo Settings → Secrets →
# Actions). The default GITHUB_TOKEN cannot write secrets, so rotation
# needs this. Only used by the refresh workflow, never by the bot.
