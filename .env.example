# Copy these into GitHub Secrets (repo Settings → Secrets → Actions)
# or Vercel Dashboard → Project → Settings → Environment Variables
# (Vercel: use "Import .env" with your filled local .env file).
# NEVER commit real values to git (.env is gitignored).

# Facebook Page (Ethan Cole — ID already filled)
FB_PAGE_ID=1264009986803820
# Long-lived Page token (~60 days). Mint via Graph Explorer, see README.
FB_PAGE_ACCESS_TOKEN=

# Google AI Studio key POOL (comma-separated, no spaces). The bot rotates
# the starting key every 20-min run and fails over to the next key on any
# 429/quota error, so all keys share the load evenly across the day.
GEMINI_API_KEYS=key1,key2,key3,key4,key5
# Backwards-compat single key (used only if GEMINI_API_KEYS is empty).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Backup writer (used only if all Gemini keys fail).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# Daily video rule: normal bar 4, after 20:00 UTC the bar drops to 1 so the
# day still gets its reel/video. Tune without touching code.
MIN_VIDEO_SCORE=4
VIDEO_DEADLINE_HOUR=20
VIDEO_DEADLINE_SCORE=1

# Rage mix: 3 viral posts out of every 5 (60%), boost +3 when starved.
RAGE_TARGET=3
RAGE_BOOST=3

# Anti-spam guards (defaults match the page's real ~11/day cadence).
MIN_POST_GAP_MINUTES=90
MAX_POSTS_PER_DAY=11
MIN_PUBLISH_SCORE=6
MAX_AGE_MINUTES=2880

# Vercel Cron protection (optional). If set, /api/cron requires
# Authorization: Bearer <secret> or ?key=<secret>.
CRON_SECRET=
